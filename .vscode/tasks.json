{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev",
      "type": "shell",
      "command": "(cd proxy && eval \"$(fnm env --shell bash)\" && fnm use && npm run dev) & (cd frontend && eval \"$(fnm env --shell bash)\" && fnm use && npm run dev)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "mapletool-proxy",
          "pattern": {
            "regexp": "^.*$",
            "file": 1,
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "tsx watch",
            "endsPattern": "listening on"
          }
        },
        {
          "owner": "vite",
          "pattern": {
            "regexp": "^.*$",
            "file": 1,
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "VITE",
            "endsPattern": "ready in"
          }
        }
      ]
    },
    {
      "label": "Deploy",
      "type": "shell",
      "command": "git fetch origin main:main && git push origin dev:main",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}